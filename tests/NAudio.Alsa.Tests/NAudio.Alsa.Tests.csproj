<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Linux-only ALSA backend; net11.0 so `dotnet test` runs it on a
         Linux box (or Claude's Linux sandbox). The Windows CI job runs every
         project in NAudio.slnx, so it runs here too but finds no runnable
         tests (see the exit-code note below). -->
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- On non-Linux machines this assembly contains zero runnable tests
         (MTP exit code 8). Treat that as success so `dotnet test` on
         Windows/macOS doesn't fail the whole solution run. MTP-based
         `dotnet test` insists every project be a runnable Exe, so there
         is no clean "drop out of discovery" gate to use instead. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- Whole assembly is Linux-only; keeps CA1416 quiet when calling the
         [SupportedOSPlatform("linux")] NAudio.Alsa surface. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NAudio.Alsa\NAudio.Alsa.csproj" />
    <ProjectReference Include="..\..\src\NAudio.Core\NAudio.Core.csproj" />
  </ItemGroup>

</Project>
