<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cross-platform half of the old NAudioTests suite. Single TFM so we
         don't double-run on Windows; targets net10.0 (no -windows) so the
         project runs on Linux/macOS too. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the demo's network-chat codec sources so we can roundtrip-test them without referencing the WinForms exe. -->
    <Compile Include="..\..\samples\NAudioDemo\NetworkChatDemo\INetworkChatCodec.cs" Link="Codecs\Linked\INetworkChatCodec.cs" />
    <Compile Include="..\..\samples\NAudioDemo\NetworkChatDemo\OpusChatCodec.cs" Link="Codecs\Linked\OpusChatCodec.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform references only. The meta-package's portable net10.0 asset
         references only Core and Midi, so these tests do not use Windows backends.
         AudioFileReader's Windows decoding paths are tested in NAudio.Windows.Tests. -->
    <ProjectReference Include="..\..\src\NAudio.Core\NAudio.Core.csproj" />
    <ProjectReference Include="..\..\src\NAudio.Midi\NAudio.Midi.csproj" />
    <ProjectReference Include="..\..\src\NAudio\NAudio.csproj" />
  </ItemGroup>

</Project>
